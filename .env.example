# Optional - this is the server's OWN fallback key, used only for visitors
# who haven't entered their own (via the "API Key" button in the app). Get a
# free key (no credit card needed) at https://console.groq.com/keys. Leave
# unset entirely and the app still works - everyone just needs their own key
# via the UI, or gets MOCK_MODE's canned data below.
GROQ_API_KEY=

# Set to "true" to run without an API key using canned/templated responses.
# Only applies to a visitor who hasn't supplied their own key via the "API
# Key" button - a visitor's own key always runs live, regardless of this.
# Leave unset or "false" once you have a real GROQ_API_KEY.
MOCK_MODE=true

PORT=3000

# Optional: override the Groq model without touching code. Free-tier model
# availability and quotas shift over time - if the default in llmClient.js
# ever 404s or its daily quota is too tight, set a replacement here.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: enables the "Share" button, which saves the current analysis
# (feedback, themes, RICE edits, decisions, PRD) to a persistent link like
# /p/abc123 that other people can open. A free Postgres database works well
# here - e.g. https://neon.tech (no credit card, no inactivity pause).
# Leave unset and sharing is simply disabled - everything else still works.
# DATABASE_URL=
