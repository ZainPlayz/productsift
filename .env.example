# Get a free key (no credit card needed) at https://console.groq.com/keys.
# Shared by every visitor to this deployment - see the rate limiting note in
# the README for how abuse/cost is kept in check without per-visitor keys.
GROQ_API_KEY=

# Set to "true" to run without an API key using canned/templated responses.
# Leave unset or "false" once you have a real GROQ_API_KEY.
MOCK_MODE=true

PORT=3000

# Optional: override the Groq model without touching code. Free-tier model
# availability and quotas shift over time - if the default in llmClient.js
# ever 404s or its daily quota is too tight, set a replacement here.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: enables accounts, organizations, and projects - log in, create an
# org, and drop feedback into a shared project with teammates, attributed to
# who dropped it and when. A free Postgres database works well here - e.g.
# https://neon.tech (no credit card, no inactivity pause). Leave unset and
# logging in is simply disabled - the anonymous single-paste flow still works.
# DATABASE_URL=
