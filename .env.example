# Get a free key (no credit card needed) at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Set to "true" to run without an API key using canned/templated responses.
# Leave unset or "false" once you have a real GEMINI_API_KEY.
MOCK_MODE=true

PORT=3000

# Optional: override the Gemini model without touching code. Free-tier model
# availability and quotas shift over time - if the default in llmClient.js
# ever 404s or its daily quota is too tight, set a replacement here.
# GEMINI_MODEL=gemini-3.6-flash
